{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/scripts/secret_guard.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/scripts/large_file_policy.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/scripts/command_guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/scripts/post_write_warnings.py"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/scripts/remind-compact.sh"
          }
        ]
      }
    ]
  }
}
