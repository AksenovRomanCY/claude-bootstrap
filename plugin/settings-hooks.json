{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/scripts/command_guard.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/scripts/command_guard.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/scripts/command_guard.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/scripts/remind-compact.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
