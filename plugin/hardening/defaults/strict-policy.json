{
  "version": 1,
  "managedBy": "claude-bootstrap",
  "profile": "strict",
  "protectedBranches": [
    "main",
    "master",
    "release",
    "production"
  ],
  "production": {
    "markers": [
      "prod",
      "production",
      "live"
    ],
    "kubeContexts": [],
    "terraformWorkspaces": []
  },
  "paths": {
    "safeRecursiveDelete": [
      ".cache",
      "dist",
      "build",
      "tmp"
    ],
    "generated": [
      "**/generated/**",
      "**/*.generated.*",
      "**/vendor/**"
    ]
  },
  "largeFiles": {
    "warningLines": 600,
    "askOnCreateLines": 900,
    "askOnGrowthLines": 75
  },
  "commandGuard": {
    "unknownEnvironment": "high-risk"
  },
  "database": {
    "destructiveOperations": "deny"
  }
}
