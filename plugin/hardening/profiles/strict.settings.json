{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.kube/config)",
      "Bash(gh repo delete *)",
      "Bash(git stash clear *)",
      "Bash(npm unpublish *)",
      "Bash(terraform destroy *)",
      "Bash(kubectl delete namespace *)",
      "Bash(kubectl delete namespaces *)",
      "Bash(kubectl delete ns *)"
    ],
    "ask": [
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(yarn npm publish *)",
      "Bash(cargo publish *)",
      "Bash(twine upload *)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(terraform apply *)",
      "Bash(kubectl delete *)",
      "Bash(helm uninstall *)",
      "Bash(docker system prune *)",
      "Bash(prisma migrate deploy *)",
      "Bash(alembic upgrade *)",
      "Bash(psql *)",
      "Bash(mysql *)",
      "Bash(sqlite3 *)"
    ]
  }
}
