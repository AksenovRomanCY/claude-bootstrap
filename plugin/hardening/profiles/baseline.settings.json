{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.kube/config)",
      "Bash(gh repo delete *)",
      "Bash(git stash clear *)",
      "Bash(npm unpublish *)"
    ],
    "ask": [
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(yarn npm publish *)",
      "Bash(cargo publish *)",
      "Bash(twine upload *)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(kubectl delete *)",
      "Bash(helm uninstall *)"
    ]
  }
}
