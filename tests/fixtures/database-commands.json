[
  {
    "name": "drop database asks under the default policy",
    "command": "psql -c 'DROP DATABASE app'",
    "policy": {
      "database": {
        "destructiveOperations": "ask"
      }
    },
    "decision": "ask",
    "rule": "DB-DESTRUCTIVE"
  },
  {
    "name": "drop database denies when the policy says deny",
    "command": "psql -c 'DROP DATABASE app'",
    "policy": {
      "database": {
        "destructiveOperations": "deny"
      }
    },
    "decision": "deny",
    "rule": "DB-DESTRUCTIVE"
  },
  {
    "name": "database rules are off until the policy enables them",
    "command": "psql -c 'DROP DATABASE app'",
    "decision": "none"
  },
  {
    "name": "drop table through the long option",
    "command": "psql --command='DROP TABLE users'",
    "policy": {
      "database": {
        "destructiveOperations": "ask"
      }
    },
    "decision": "ask",
    "rule": "DB-DESTRUCTIVE"
  },
  {
